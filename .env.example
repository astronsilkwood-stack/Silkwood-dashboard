DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
STAFF_PIN=choose-a-4-to-6-digit-pin
MANAGER_PIN=1945
# Closing checklist forward. Leave blank to return 503 on submit.
CLOSING_WEBHOOK_URL=
CLOSING_WEBHOOK_KEY=
# Kitchen daily checklist forward. Leave blank to return 503 on submit.
KITCHEN_WEBHOOK_URL=
KITCHEN_WEBHOOK_KEY=
# Customer pickup orders from /order. If either is blank, or the webhook fails, the order is still saved.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_KEY=
# Owner portal (/portal). Leave the hash blank until you generate one. See README.
# python3 tools/hash_portal_password.py
PORTAL_ADMIN_USER=astron
PORTAL_ADMIN_PASSWORD_HASH=
# Bearer key for the nightly upload and the staff-hours read. A long random string.
PORTAL_INGEST_KEY=
# Optional. Session length in hours (default 12). Set to 0 only for local HTTP cookies.
# PORTAL_SESSION_HOURS=12
# PORTAL_COOKIE_SECURE=0
# PORTAL_INSIGHTS_GENERATE=0
